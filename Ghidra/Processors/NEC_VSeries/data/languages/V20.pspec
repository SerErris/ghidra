<?xml version="1.0" encoding="UTF-8"?>

<!-- NEC V20 (uPD70108) - 8088-compatible, enhanced core, 8-bit external data
     bus, CPU only (no on-chip peripherals).  16-bit real mode.
     The external data-bus width (8- vs 16-bit) is invisible to the
     disassembler, so the V20 shares vseries.sla and this pspec matches V30.
     Segment/PC/context setup modeled on Ghidra's x86-16-real.pspec. -->
<processor_spec>
  <properties>
    <property key="useOperandReferenceAnalyzerSwitchTables" value="true"/>
  </properties>
  <programcounter register="PC"/>
  <segmented_address space="ram" type="real"/>
  <segmentop space="ram" userop="segment" farpointer="yes">
    <pcode>
      <input name="base" size="2"/>
      <input name="inner" size="2"/>
      <output name="res" size="4"/>
      <body><![CDATA[
        res = ((zext(base) << 4) + zext(inner)) & 0xFFFFF;
      ]]></body>
    </pcode>
    <constresolve>
      <register name="DS0"/>
    </constresolve>
  </segmentop>
  <context_data>
    <tracked_set space="ram">
      <set name="DIR" val="0"/>
    </tracked_set>
  </context_data>
</processor_spec>
